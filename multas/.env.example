# Copia este archivo a .env.local y rellena los valores.
#
# Supabase en la nube: Project Settings → API
#   VITE_SUPABASE_URL      = Project URL (https://<ref>.supabase.co)
#   VITE_SUPABASE_ANON_KEY = anon / publishable key (es pública; la seguridad está en RLS + RPCs)
#
# Supabase local (npx supabase start): usa API_URL y ANON_KEY que imprime el comando.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
